            ".validate": "newData.isBoolean()"
          },
          "activity30d": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "consultation": {
          ".validate": false
        },
        "$other": {
          ".validate": false
        },
        "holdUntil": {
          ".validate": "newData.isNumber()",
          ".write": "auth != null && data.exists() && !newData.exists() && root.child('appointments').child($id).child('patientId').val() === auth.uid && newData.parent().child('status').val() === 'confirmed'"
        },
        "payment": {
          ".write": "auth != null && !data.exists() && root.child('appointments').child($id).child('patientId').val() === auth.uid && root.child('appointments').child($id).child('status').val() === 'pending_payment' && root.child('appointments').child($id).child('holdUntil').val() > now",
          ".validate": "newData.hasChildren(['transactionId','method','status','consultationFee','platformFee','total','reference','mode','paidAt']) && ((newData.child('method').val() === 'clinic' && newData.child('status').val() === 'pay_at_clinic') || ((newData.child('method').val() === 'card' || newData.child('method').val() === 'wallet') && newData.child('status').val() === 'paid')) && newData.child('mode').val() === 'sandbox'",
          "transactionId": {
            ".validate": "newData.isString() && newData.val().length >= 6 && newData.val().length <= 40"
          },
          "method": {
            ".validate": "newData.val() === 'card' || newData.val() === 'wallet' || newData.val() === 'clinic'"
          },
          "status": {
            ".validate": "newData.val() === 'paid' || newData.val() === 'pay_at_clinic'"
          },
          "consultationFee": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
          },
          "platformFee": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          },
          "total": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1100000"
          },
          "brand": {
            ".validate": "newData.val() === 'Visa' || newData.val() === 'Mastercard'"
          },
          "last4": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}$/)"
          },
          "wallet": {
            ".validate": "newData.val() === 'jazzcash' || newData.val() === 'easypaisa'"
          },
          "reference": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80"
          },
          "mode": {
            ".validate": "newData.val() === 'sandbox'"
          },
          "paidAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "config": {
      "payments": {
        "platformFee": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        }
      },
      ".read": "auth != null",
      ".write": false
    }
  }
}
