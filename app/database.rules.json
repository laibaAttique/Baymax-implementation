          ".write": "auth != null && data.exists() && root.child('appointments').child($id).child('patientId').val() === auth.uid && (((data.val() === 'confirmed' || data.val() === 'pending_payment') && newData.val() === 'cancelled' && root.child('appointments').child($id).child('startAt').val() > now) || (data.val() === 'pending_payment' && newData.val() === 'confirmed' && root.child('appointments').child($id).child('holdUntil').val() > now && (newData.parent().child('payment').child('status').val() === 'paid' || newData.parent().child('payment').child('status').val() === 'pay_at_clinic') && newData.parent().child('payment').child('consultationFee').val() === root.child('appointments').child($id).child('fee').val() && newData.parent().child('payment').child('platformFee').val() === (root.child('config').child('payments').child('platformFee').exists() ? root.child('config').child('payments').child('platformFee').val() : 0) && newData.parent().child('payment').child('total').val() === newData.parent().child('payment').child('consultationFee').val() + newData.parent().child('payment').child('platformFee').val()))"
