{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "profile": {
          ".validate": "newData.hasChildren(['fullName', 'height', 'weight'])",
          "fullName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
          },
          "dob": {
            ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/))"
          },
          "gender": {
            ".validate": "newData.isString() && newData.val().length <= 20"
          },
          "height": {
            ".validate": "newData.hasChildren(['value', 'unit'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "unit": {
              ".validate": "newData.val() === 'cm' || newData.val() === 'ft'"
            },
            "$other": {
              ".validate": false
            }
          },
          "weight": {
            ".validate": "newData.hasChildren(['value', 'unit'])",
            "value": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "unit": {
              ".validate": "newData.val() === 'kg' || newData.val() === 'lbs'"
            },
            "$other": {
              ".validate": false
            }
          },
          "targetWeight": {
            "value": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "unit": {
              ".validate": "newData.val() === 'kg' || newData.val() === 'lbs'"
            },
            "$other": {
              ".validate": false
            }
          },
          "medicalConditions": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          },
          "foodAllergies": {
            "$i": {
              ".validate": "newData.isString() && newData.val().length <= 50"
            }
          },
          "medications": {
            ".validate": "newData.isString() && newData.val().length <= 1000"
          },
          "primaryGoal": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "activityLevel": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          },
          "workoutFrequency": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "calculatedBMI": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 200"
          },
          "healthClassification": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "planVariant": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "foodLog": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
            "$entry": {
              ".validate": "newData.hasChildren(['meal', 'name', 'kcal'])",
              "meal": {
                ".validate": "newData.val() === 'Breakfast' || newData.val() === 'Lunch' || newData.val() === 'Dinner' || newData.val() === 'Snack'"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120"
              },
              "quantity": {
                ".validate": "newData.isNumber() && newData.val() >= 0"
              },
              "unit": {
                ".validate": "newData.isString() && newData.val().length <= 30"
              },
              "kcal": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000"
              },
              "protein": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "carbs": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "fat": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
              },
              "source": {
                ".validate": "newData.val() === 'text' || newData.val() === 'image' || newData.val() === 'manual'"
              },
              "ref": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "createdAt": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "activity": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['workoutDone'])",
            "workoutDone": {
              ".validate": "newData.val() === true"
            },
            "minutes": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600"
            },
            "kcal": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"
            },
            "completedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "badges": {
          "$id": {
            ".validate": "$id.matches(/^[a-z0-9_]{1,30}$/) && newData.isNumber()"
          }
        },
        "settings": {
          "leaderboardOptIn": {
            ".validate": "newData.isBoolean()"
          },
          "displayName": {
            ".validate": "newData.isString() && newData.val().length <= 30"
          },
          "reminderEnabled": {
            ".validate": "newData.isBoolean()"
          },
          "reminderHour": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
          },
          "reminderMinute": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 59"
          },
          "inactivityAlerts": {
            ".validate": "newData.isBoolean()"
          },
          "$other": {
            ".validate": false
          }
        },
        "weights": {
          "$date": {
            ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.hasChildren(['kg'])",
            "kg": {
              ".validate": "newData.isNumber() && newData.val() >= 20 && newData.val() <= 400"
            },
            "loggedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false,
        ".validate": "newData.isString() && newData.val().matches(/^(user|doctor|nutritionist|trainer|admin)$/)"
      }
    },
    "leaderboard": {
      "$week": {
        ".validate": "$week.matches(/^[0-9]{4}-W[0-9]{2}$/)",
        ".read": "auth != null",
        ".indexOn": [
          "score"
        ],
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['name', 'score'])",
          "name": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
          },
          "score": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "workouts": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "logDays": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 7"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    }
  }
}
