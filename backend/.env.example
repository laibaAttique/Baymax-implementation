# Copy to .env and fill in. Never commit .env.
PORT=3000

# Google Cloud Vision API key (label OCR for the allergy scanner)
GOOGLE_VISION_API_KEY=

# Free key from https://api.data.gov/signup/ (USDA FoodData Central; used by tools/verify_foods.js)
USDA_API_KEY=

# Firebase project whose ID tokens the server accepts (default: baymax-148da)
FIREBASE_PROJECT_ID=baymax-148da

# Legacy Express/MongoDB routes (the app now stores data in Firebase)
MONGODB_URI=

# Dialogflow ES agent for the voice assistant (Module 6). Path to a service-account
# JSON key with the "Dialogflow API Client" role. Keep the key file out of git.
DIALOGFLOW_KEY_FILE=
# Optional: defaults to the key file's project_id
DIALOGFLOW_PROJECT_ID=
