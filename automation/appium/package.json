{
  "name": "baymax-appium-e2e",
  "private": true,
  "description": "Real-device UI automation for Baymax Modules 4 (workout plan), 5 (posture detection) and 6 (voice assistant): Appium + UiAutomator2 + WebdriverIO.",
  "type": "module",
  "scripts": {
    "test": "wdio run ./wdio.conf.js",
    "test:m4": "wdio run ./wdio.conf.js --spec ./tests/module4_workout.e2e.js",
    "test:m5": "wdio run ./wdio.conf.js --spec ./tests/module5_posture.e2e.js",
    "test:m6": "wdio run ./wdio.conf.js --spec ./tests/module6_voice.e2e.js",
    "test:cross": "wdio run ./wdio.conf.js --spec ./tests/cross_module.e2e.js",
    "doctor": "appium driver doctor uiautomator2"
  },
  "devDependencies": {
    "@wdio/appium-service": "9.32.0",
    "@wdio/cli": "9.32.0",
    "@wdio/junit-reporter": "9.32.0",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "appium": "3.8.0",
    "appium-uiautomator2-driver": "8.7.0",
    "webdriverio": "9.32.0"
  }
}
