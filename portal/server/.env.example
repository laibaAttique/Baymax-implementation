# Same Firebase project as the mobile app (baymax-148da).
FIREBASE_DATABASE_URL=https://baymax-148da-default-rtdb.firebaseio.com

# Path to a service-account key for that project. Keep the file OUTSIDE this folder and never commit it.
# Firebase console -> Project settings -> Service accounts -> Generate new private key.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json

# Where the Next.js portal runs (comma-separated list allowed). Only these origins may call the API from a browser.
PORTAL_ORIGIN=http://localhost:3000

PORT=4000
