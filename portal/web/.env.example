# The portal's Express API (see ../server).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Firebase WEB app config for the same project as the mobile app (baymax-148da).
# Firebase console -> Project settings -> General -> Your apps -> Add app -> Web, then copy these values.
# These identify the project; they are not secrets, but they are not committed either.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=baymax-148da.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=baymax-148da
NEXT_PUBLIC_FIREBASE_APP_ID=
